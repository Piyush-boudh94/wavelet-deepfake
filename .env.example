# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.example .env
#
# Nothing in this project requires a credential to TRAIN. These exist only for
# optional experiment tracking and for dataset access, which is negotiated with
# the dataset authors directly -- see docs/DATA.md.

# --- Paths (override only if you relocate the project) ---
WMAMBA_ROOT=/home/dgx-s-bmu-cse-240577/research
WMAMBA_DATA_ROOT=/home/dgx-s-bmu-cse-240577/research/data

# --- Kubernetes ---
# Namespace only. NEVER put a kubeconfig, token, or service-account key in here;
# kubectl reads credentials from ~/.kube/config outside the repo.
WMAMBA_NS=dgx-s-bmu-cse-240577-restricted
WMAMBA_APP=wmamba-dev

# --- Optional experiment tracking (leave blank to disable) ---
WANDB_API_KEY=
WANDB_PROJECT=wmamba
WANDB_MODE=offline

# --- Optional: HuggingFace, only if pulling backbone weights via HF ---
HF_TOKEN=
